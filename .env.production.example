# ============================================================
# TEMPLATE PRODUKSI - MINDSIA v2
# Cara pakai di server:
#   1. cp .env.production .env
#   2. Isi semua baris bertanda  <<< ISI
#   3. php artisan key:generate
#   4. chmod 600 .env
#   5. php artisan config:cache route:cache view:cache
# JANGAN commit file .env (hanya template ini yang boleh di repo).
# ============================================================

APP_NAME=MINDSIA
APP_ENV=production
APP_KEY=                                  # kosongkan, di-generate: php artisan key:generate
APP_DEBUG=false
APP_URL=https://mindsia.id
TRUSTED_PROXIES=*                         # set spesifik IP proxy kalau pakai Cloudflare/nginx di depan
HASH_DRIVER=argon2id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database --- <<< ISI (JANGAN root/root)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=                              # <<< ISI nama db produksi
DB_USERNAME=                              # <<< ISI user khusus app (bukan root)
DB_PASSWORD=                              # <<< ISI password kuat (>16 char acak)

# --- Session (diperketat untuk data PII + HTTPS) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# WAJIB null (cookie per-host) agar isolasi guard subdomain tidak bocor.
# Jangan set .mindsia.id - employee bakal bocor ke member.
SESSION_DOMAIN=null
# Nama cookie di-versioning. Naikkan sufiks (_v3, ...) kalau ganti SESSION_DOMAIN
# lagi, biar cookie lama di browser user tidak bentrok (hindari 419 CSRF).
SESSION_COOKIE=mindsia_session_v2
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null                       # set password kalau Redis kebuka ke jaringan
REDIS_PORT=6379

# --- Mail --- <<< ISI (tanpa ini reset password + OTP mati)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=                                # <<< ISI (mis. smtp.mailgun.org / email-smtp.ap-southeast-1.amazonaws.com)
MAIL_PORT=587
MAIL_USERNAME=                            # <<< ISI
MAIL_PASSWORD=                            # <<< ISI
MAIL_FROM_ADDRESS="noreply@mindsia.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Integrasi MINDSIA (docx->pdf + Telegram storage) --- <<< ISI dari .env lama
CONVERSION_API=                           # <<< ISI token ConvertApi
TELEGRAM_BOT_TOKEN=                       # <<< ISI token bot Telegram
GROUP_LOG=                                # <<< ISI chat id grup log
GROUP_STORAGE=                            # <<< ISI chat id grup storage

VITE_APP_NAME="${APP_NAME}"
